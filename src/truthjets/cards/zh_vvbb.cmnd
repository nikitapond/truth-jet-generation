! ZH associated production with H -> bb, Z -> vv (invisible)
! Suitable for Higgs tagging studies with large-R jets

! ZH production
HiggsSM:ffbar2HZ = on

! Force H -> bb
25:onMode = off
25:onIfAny = 5

! Force Z -> neutrinos (invisible)
23:onMode = off
23:onIfAny = 12 14 16

! Phase space: boosted regime
PhaseSpace:pTHatMin = 150.0
